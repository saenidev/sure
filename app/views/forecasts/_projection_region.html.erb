<%# JSON data island: application/json keeps the browser from executing it. %>
<script type="application/json" id="forecast-island"><%= island.to_json.html_safe %></script><%# erblint:disable AllowedScriptType %>

<section class="bg-container border border-primary rounded-xl shadow-xs p-4 lg:p-5"
         data-controller="forecast-chart"
         data-forecast-chart-island-id-value="forecast-island">
  <div class="flex flex-wrap items-center gap-1 mb-3" role="tablist">
    <% { nw: :net_worth, lc: :cash, pv: :invested, db: :debt, sv: :saving }.each do |lens, label_key| %>
      <button type="button" role="tab"
              class="text-sm font-medium px-3 py-1.5 rounded-md text-secondary data-[active=true]:tab-item-active"
              data-forecast-chart-target="lensTab"
              data-lens="<%= lens %>"
              data-action="forecast-chart#switchLens">
        <%= t("forecasts.workspace.lenses.#{label_key}") %>
      </button>
    <% end %>
  </div>

  <div class="flex flex-col lg:flex-row gap-5">
    <div class="flex-1 min-w-0">
      <div data-forecast-chart-target="canvas" class="h-64 lg:h-72 w-full privacy-sensitive"></div>
      <input type="range" min="0" value="0"
             autocomplete="off"
             class="w-full mt-2"
             data-forecast-chart-target="scrubber"
             data-action="input->forecast-chart#scrub"
             aria-label="<%= t("forecasts.workspace.title") %>">
      <div class="flex justify-between text-xs text-subdued"
           data-forecast-chart-target="axis"></div>
    </div>

    <dl class="lg:w-56 shrink-0 divide-y divide-alpha-black-50"
        data-forecast-chart-target="metricColumn">
      <%# populated client-side from the island for the scrubbed month %>
    </dl>
  </div>

  <div class="mt-3 pt-3 border-t border-primary text-sm text-secondary flex flex-wrap items-center gap-3"
       data-forecast-chart-target="inspector">
    <%# populated client-side from the island for the selected month %>
  </div>
</section>
