<% content_for :title, t("forecasts.workspace.title") %>

<div id="forecast_workspace" class="space-y-6 pb-6 lg:pb-12">
  <%= render "forecasts/workspace_header", plan: @plan %>

  <div id="forecast_issues">
    <%= render "forecasts/workspace_issues", issues: @issues %>
  </div>

  <div id="forecast_projection_region">
    <%= render "forecasts/projection_region", plan: @plan, island: @island %>
  </div>

  <div id="forecast_assumption_rail">
    <%= render "forecasts/assumption_rail", plan: @plan, groups: @groups %>
  </div>
</div>
