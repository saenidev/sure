<% content_for :title, t(".title") %>

<div class="space-y-6">
  <header class="flex flex-wrap items-center justify-between gap-3">
    <div class="space-y-1">
      <h1 class="text-primary text-2xl font-semibold"><%= t(".title") %></h1>
      <p class="text-secondary text-sm">
        <%= t(".description") %>
      </p>
    </div>
  </header>

  <section class="rounded-lg border border-primary bg-container p-4">
    <p class="text-secondary text-sm">
      <%= t(".empty_state") %>
    </p>
  </section>
</div>
