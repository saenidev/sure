<%# locals: (workspace:) %>
<%#
  Timeline tab: one synchronized stack of lanes (cash / budget / portfolio /
  debt / goals / scenario) for a single completed run. Reads ONLY persisted
  output via Forecast::TimelineReadModel (no engine recompute). A daily/monthly
  resolution toggle (Stimulus, query-param state) swaps the cash lane's 0-90
  daily view for the 4-36 monthly view. Per-period source-contribution
  drilldowns let users answer "why is this number here?" from the stored
  source_breakdown JSON.

  Empty/edge: a family with no completed run sees the empty state (never another
  family's run, since the model is scoped through the workspace's own group).
%>
<section class="space-y-6" aria-label="<%= t("forecasts.show.tabs.timeline") %>">
  <% if workspace.timeline_data? %>
    <% model = workspace.timeline_read_model %>
    <% resolution = (params[:resolution].presence_in(%w[daily monthly]) || "daily") %>
    <%
      daily_entries = model.daily_entries
      monthly_entries = model.all_monthly_entries
      lowest_cash_entry = (daily_entries.presence || monthly_entries).min_by { |entry| entry.cash_balance.amount }
      weakest_flow_month = monthly_entries.min_by { |entry| entry.net_cash_flow.amount }
      runway_values = (daily_entries + monthly_entries).filter_map(&:cash_runway_days)
      minimum_runway_days = runway_values.min
      debt_pressure_count = monthly_entries.count { |entry| model.debt_pressure?(entry) }
    %>

    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="space-y-1">
        <h3 class="text-primary text-base font-medium"><%= t("forecasts.timeline.heading") %></h3>
        <p class="text-secondary text-sm"><%= t("forecasts.timeline.description") %></p>
      </div>
    </div>

    <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4" data-testid="timeline-summary">
      <div class="rounded-xl border border-primary bg-container p-4">
        <dt class="flex items-center gap-2 text-secondary text-xs">
          <%= icon "arrow-down-to-line", size: "xs", color: "default" %>
          <span><%= t("forecasts.timeline.summary.lowest_cash") %></span>
        </dt>
        <dd class="mt-2 text-primary text-lg font-semibold tabular-nums">
          <%= lowest_cash_entry ? format_money(lowest_cash_entry.cash_balance) : t("forecasts.overview.metrics.unavailable") %>
        </dd>
        <dd class="mt-1 text-secondary text-xs">
          <% if lowest_cash_entry.respond_to?(:date) %>
            <%= l(lowest_cash_entry.date, format: :long) %>
          <% elsif lowest_cash_entry %>
            <%= l(lowest_cash_entry.period_start_on, format: :long) %>
          <% else %>
            <%= t("forecasts.timeline.summary.no_period") %>
          <% end %>
        </dd>
      </div>

      <div class="rounded-xl border border-primary bg-container p-4">
        <dt class="flex items-center gap-2 text-secondary text-xs">
          <%= icon "timer", size: "xs", color: "default" %>
          <span><%= t("forecasts.timeline.summary.cash_runway") %></span>
        </dt>
        <dd class="mt-2 text-primary text-lg font-semibold tabular-nums">
          <%= minimum_runway_days.present? ? t("forecasts.timeline.cash_lane.runway_days", count: minimum_runway_days) : t("forecasts.brief.kpis.runway.unbounded") %>
        </dd>
        <dd class="mt-1 text-secondary text-xs"><%= t("forecasts.timeline.summary.worst_runway") %></dd>
      </div>

      <div class="rounded-xl border border-primary bg-container p-4">
        <dt class="flex items-center gap-2 text-secondary text-xs">
          <%= icon "activity", size: "xs", color: "default" %>
          <span><%= t("forecasts.timeline.summary.weakest_flow") %></span>
        </dt>
        <dd class="mt-2 text-primary text-lg font-semibold tabular-nums">
          <%= weakest_flow_month ? format_money(weakest_flow_month.net_cash_flow) : t("forecasts.overview.metrics.unavailable") %>
        </dd>
        <dd class="mt-1 text-secondary text-xs">
          <%= weakest_flow_month ? l(weakest_flow_month.period_start_on, format: :long) : t("forecasts.timeline.summary.no_period") %>
        </dd>
      </div>

      <div class="rounded-xl border border-primary bg-container p-4">
        <dt class="flex items-center gap-2 text-secondary text-xs">
          <%= icon "badge-alert", size: "xs", color: "default" %>
          <span><%= t("forecasts.timeline.summary.debt_pressure") %></span>
        </dt>
        <dd class="mt-2 text-primary text-lg font-semibold tabular-nums">
          <%= t("forecasts.timeline.summary.debt_pressure_count", count: debt_pressure_count) %>
        </dd>
        <dd class="mt-1 text-secondary text-xs"><%= t("forecasts.timeline.debt_lane.pressure.flag") %></dd>
      </div>
    </dl>

    <div class="space-y-4"
         data-controller="forecast-timeline"
         data-forecast-timeline-resolution-value="<%= resolution %>">
      <%# Resolution toggle: declarative, keyboard-operable, query-param state. %>
      <div class="inline-flex rounded-lg border border-primary p-0.5" role="group"
           aria-label="<%= t("forecasts.timeline.resolution.label") %>">
        <button type="button"
                class="rounded-md px-3 py-1 text-sm font-medium text-secondary aria-pressed:bg-surface-inset aria-pressed:text-primary"
                aria-pressed="<%= resolution == "daily" %>"
                data-forecast-timeline-target="button"
                data-resolution="daily"
                data-action="forecast-timeline#select">
          <%= t("forecasts.timeline.resolution.daily") %>
        </button>
        <button type="button"
                class="rounded-md px-3 py-1 text-sm font-medium text-secondary aria-pressed:bg-surface-inset aria-pressed:text-primary"
                aria-pressed="<%= resolution == "monthly" %>"
                data-forecast-timeline-target="button"
                data-resolution="monthly"
                data-action="forecast-timeline#select">
          <%= t("forecasts.timeline.resolution.monthly") %>
        </button>
      </div>

      <%# Cash lane is the only resolution-aware lane: it swaps between the 0-90
          daily pane and the 4-36 monthly pane. The remaining lanes are monthly
          by nature and render once. %>
      <%= render "forecast/timeline/cash_lane", model: model, resolution: resolution %>
      <%= render "forecast/timeline/budget_lane", model: model %>
      <%= render "forecast/timeline/portfolio_lane", model: model %>
      <%= render "forecast/timeline/debt_lane", model: model %>
      <%= render "forecast/timeline/goals_lane", model: model %>
      <%= render "forecast/timeline/scenario_lane", model: model %>
    </div>
  <% else %>
    <%# No completed run for this family yet. %>
    <div class="rounded-xl border border-primary bg-container p-8 text-center"
         aria-labelledby="forecast-timeline-empty-title"
         data-testid="timeline-empty-state">
      <div class="mx-auto flex max-w-md flex-col items-center gap-3">
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-surface-inset" aria-hidden="true">
          <%= icon "calendar", size: "lg", color: "default" %>
        </span>
        <div class="space-y-1">
          <h3 id="forecast-timeline-empty-title" class="text-primary text-lg font-medium">
            <%= t("forecasts.timeline.empty.title") %>
          </h3>
          <p class="text-secondary text-sm"><%= t("forecasts.timeline.empty.body") %></p>
        </div>
      </div>
    </div>
  <% end %>
</section>
