<div id="<%= dom_id(assumption) %>"
     class="bg-container border border-primary rounded-lg shadow-xs hover:bg-container-hover">
  <%= link_to edit_forecasts_assumption_path(assumption),
        class: "block p-3",
        data: { turbo_frame: "modal" },
        aria: { label: t("forecasts.workspace.card.edit", name: assumption.name) } do %>
    <div class="flex items-baseline justify-between gap-2">
      <span class="flex items-center gap-2 min-w-0">
        <%= icon Forecasts::Assumptions::Registry.icon_for(assumption.kind), size: "sm" %>
        <span class="text-sm font-medium text-primary truncate"><%= assumption.name %></span>
      </span>
      <span class="text-sm font-semibold text-primary whitespace-nowrap privacy-sensitive">
        <%= t("forecasts.workspace.card.per_month",
              amount: Money.new(assumption.amount, assumption.currency).format) %>
      </span>
    </div>
    <div class="mt-1 flex items-center gap-2 text-xs text-secondary">
      <% if assumption.review_state == "needs_review" %>
        <%= render DS::Pill.new(label: t("forecasts.workspace.card.needs_review"), tone: :amber, marker: false) %>
      <% end %>
      <% if assumption.origin == "source_derived" %>
        <span class="text-link"><%= t("forecasts.workspace.card.derived") %></span>
      <% end %>
    </div>
  <% end %>
  <% resync_state = local_assigns[:resync_state] %>
  <% proposal = local_assigns[:proposal] %>
  <% if resync_state %>
    <div class="px-3 pb-3 text-xs">
      <% case resync_state %>
      <% when :proposal %>
        <p class="text-secondary privacy-sensitive">
          <%= t("forecasts.workspace.card.resync.proposal",
                current: Money.new(assumption.amount, assumption.currency).format,
                proposed: Money.new(proposal.amount, proposal.currency).format) %>
        </p>
        <div class="mt-2 flex items-center gap-3">
          <%= button_to t("forecasts.workspace.card.resync.accept"),
                forecasts_assumption_resync_path(assumption),
                params: { expected_lock_version: assumption.lock_version },
                class: "text-link text-xs font-medium" %>
          <%= link_to t("forecasts.workspace.card.resync.keep"),
                forecasts_assumption_resync_path(assumption, cancel: 1),
                data: { turbo_stream: true },
                class: "text-secondary hover:text-primary" %>
        </div>
      <% when :in_sync %>
        <p class="text-secondary"><%= t("forecasts.workspace.card.resync.in_sync") %></p>
        <%= link_to t("forecasts.workspace.card.resync.dismiss"),
              forecasts_assumption_resync_path(assumption, cancel: 1),
              data: { turbo_stream: true },
              class: "mt-1 inline-block text-secondary underline hover:text-primary" %>
      <% when :source_gone %>
        <p class="text-secondary"><%= t("forecasts.workspace.card.resync.source_gone") %></p>
        <%= link_to t("forecasts.workspace.card.resync.dismiss"),
              forecasts_assumption_resync_path(assumption, cancel: 1),
              data: { turbo_stream: true },
              class: "mt-1 inline-block text-secondary underline hover:text-primary" %>
      <% end %>
    </div>
  <% elsif assumption.origin == "source_derived" %>
    <div class="px-3 pb-2">
      <%= link_to forecasts_assumption_resync_path(assumption),
            data: { turbo_stream: true },
            class: "inline-flex items-center gap-1 text-xs text-secondary hover:text-primary",
            aria: { label: t("forecasts.workspace.card.resync.refresh", name: assumption.name) } do %>
        <%= icon "refresh-cw", size: "xs", color: "current" %>
        <span><%= t("forecasts.workspace.card.resync.refresh_label") %></span>
      <% end %>
    </div>
  <% end %>
  <% if assumption.drift_nudge? %>
    <aside role="status"
           class="border-t border-warning/20 bg-warning/10 rounded-b-lg px-3 py-2">
      <p class="text-xs text-warning privacy-sensitive">
        <%= t("forecasts.workspace.card.drift.nudge",
              name: assumption.name,
              current: Money.new(assumption.amount, assumption.currency).format,
              proposed: Money.new(assumption.drift_proposed_amount, assumption.currency).format) %>
      </p>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <%= button_to t("forecasts.workspace.card.drift.accept"),
              forecasts_assumption_resync_path(assumption),
              params: { expected_lock_version: assumption.lock_version },
              class: "text-xs font-medium text-primary bg-container border border-primary rounded-md px-2 py-1 hover:bg-container-hover" %>
        <%= button_to t("forecasts.workspace.card.drift.dismiss"),
              forecasts_assumption_drift_dismissal_path(assumption),
              class: "text-xs font-medium text-secondary px-2 py-1 hover:text-primary" %>
        <%= button_to t("forecasts.workspace.card.drift.dismiss_permanently"),
              forecasts_assumption_drift_dismissal_path(assumption),
              params: { permanent: "1" },
              class: "text-xs text-secondary px-2 py-1 hover:text-primary" %>
      </div>
    </aside>
  <% elsif assumption.drift_source_gone? %>
    <aside role="status" class="border-t border-primary px-3 py-2">
      <p class="text-xs text-secondary"><%= t("forecasts.workspace.card.drift.source_gone") %></p>
      <%= button_to t("forecasts.workspace.card.drift.source_gone_ok"),
            forecasts_assumption_drift_dismissal_path(assumption),
            class: "mt-1 text-xs font-medium text-secondary border border-primary rounded-md px-2 py-1 hover:bg-container-hover" %>
    </aside>
  <% end %>
  <% if assumption.review_state == "needs_review" %>
    <div class="border-t border-primary px-3 py-2">
      <%= button_to t("forecasts.workspace.card.review.confirm"),
            forecasts_assumption_review_confirmation_path(assumption),
            class: "text-xs font-medium text-link hover:underline" %>
    </div>
  <% end %>
</div>
