<%# locals: (workspace:) %>
<section class="space-y-8" aria-label="<%= t("forecasts.show.tabs.outlook") %>">
  <div class="space-y-1">
    <h3 class="text-primary text-base font-medium"><%= t("forecasts.outlook.heading") %></h3>
    <p class="text-secondary text-sm"><%= t("forecasts.outlook.description") %></p>
  </div>

  <%= render "forecasts/overview", workspace: workspace, include_monthly_table: false %>

  <div class="border-t border-primary pt-6">
    <%= render "forecasts/timeline", workspace: workspace %>
  </div>

  <% if workspace.overview_data? %>
    <div class="border-t border-primary pt-6">
      <%= render "forecasts/monthly_table", months: workspace.monthly_rows.to_a, currency: workspace.currency %>
    </div>
  <% end %>
</section>
