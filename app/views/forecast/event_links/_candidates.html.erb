<%# locals: (event:, occurrence_on:, candidates:, currency:) %>

<%#
  Read-only candidate list for this unmatched occurrence. `candidates` is built
  by Forecast::Reconciliation#candidates_for in a single batched pass across all
  unmatched rows (one entries query + one accepted-claim load shared by every
  row), so rendering this partial issues NO per-row query.
%>

<div class="space-y-3 border-t border-primary pt-4"
     data-testid="<%= dom_id(event, :candidates) %>">
  <h5 class="text-secondary text-xs font-medium uppercase tracking-wide">
    <%= t("forecasts.reconciliation.candidates.heading") %>
  </h5>

  <% if candidates.empty? %>
    <p class="text-secondary text-sm" data-testid="<%= dom_id(event, :no_candidates) %>">
      <%= t("forecasts.reconciliation.candidates.empty") %>
    </p>
  <% else %>
    <ul class="space-y-2" role="list">
      <% candidates.each do |candidate| %>
        <%= render "forecast/event_links/candidate",
              event: event,
              occurrence_on: occurrence_on,
              candidate: candidate,
              currency: currency %>
      <% end %>
    </ul>
  <% end %>
</div>
