<% content_for :title, t("forecasts.canvas.title") %>

<div class="space-y-4 pb-6 lg:pb-12">
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div class="space-y-1">
      <h1 class="text-primary text-2xl font-semibold"><%= t("forecasts.canvas.title") %></h1>
      <p class="text-secondary text-sm"><%= t("forecasts.canvas.description") %></p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <%= render DS::Link.new(
        text: t("forecasts.canvas.back"),
        icon: "arrow-left",
        href: forecast_path,
        variant: "outline"
      ) %>
      <%= render DS::Button.new(
        text: t("forecasts.show.generate"),
        icon: "play",
        href: forecast_runs_path,
        disabled: @workspace.running?
      ) %>
    </div>
  </header>

  <section class="overflow-hidden rounded-lg border border-primary bg-container"
           data-controller="forecast-canvas-chart"
           data-forecast-canvas-chart-payload-value="<%= @canvas_payload.to_json %>"
           aria-labelledby="forecast-canvas-heading">
    <div class="border-b border-primary p-3 sm:p-4">
      <div class="flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between">
        <div class="space-y-1">
          <h2 id="forecast-canvas-heading" class="text-primary text-base font-medium">
            <%= t("forecasts.canvas.chart_heading") %>
          </h2>
          <p class="text-secondary text-xs" data-forecast-canvas-chart-target="sourceLabel">
            <%= t("forecasts.canvas.loading") %>
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <div class="inline-flex rounded-lg border border-primary p-0.5" role="group"
               aria-label="<%= t("forecasts.canvas.metric_label") %>">
            <% @canvas_payload.fetch(:metrics).each_with_index do |metric, index| %>
              <button type="button"
                      class="rounded-md px-3 py-1 text-sm font-medium text-secondary aria-pressed:bg-surface-inset aria-pressed:text-primary"
                      aria-pressed="<%= index.zero? %>"
                      data-forecast-canvas-chart-target="metricButton"
                      data-metric="<%= metric.fetch(:key) %>"
                      data-action="forecast-canvas-chart#selectMetric">
                <%= metric.fetch(:label) %>
              </button>
            <% end %>
          </div>

          <div class="inline-flex rounded-lg border border-primary p-0.5" role="group"
               aria-label="<%= t("forecasts.canvas.range_label") %>">
            <% [
                 [ "90d", t("forecasts.canvas.ranges.90d"), 3 ],
                 [ "1y", t("forecasts.canvas.ranges.1y"), 12 ],
                 [ "3y", t("forecasts.canvas.ranges.3y"), 36 ],
                 [ "all", t("forecasts.canvas.ranges.all"), nil ]
               ].each_with_index do |(range_key, label, months), index| %>
              <button type="button"
                      class="rounded-md px-3 py-1 text-sm font-medium text-secondary aria-pressed:bg-surface-inset aria-pressed:text-primary"
                      aria-pressed="<%= index == 2 %>"
                      data-forecast-canvas-chart-target="rangeButton"
                      data-range="<%= range_key %>"
                      data-months="<%= months %>"
                      data-action="forecast-canvas-chart#selectRange">
                <%= label %>
              </button>
            <% end %>
          </div>

          <div class="flex items-center gap-2 rounded-lg border border-primary px-2 py-1">
            <span class="min-w-44 text-secondary text-xs tabular-nums"
                  data-forecast-canvas-chart-target="viewportLabel"
                  aria-live="polite">
              <%= t("forecasts.canvas.viewport.loading") %>
            </span>

            <div class="inline-flex items-center gap-1" role="group"
                 aria-label="<%= t("forecasts.canvas.viewport.controls") %>">
              <%= render DS::Button.new(
                variant: :icon,
                size: :sm,
                icon: "zoom-out",
                type: "button",
                title: t("forecasts.canvas.viewport.zoom_out"),
                aria: { label: t("forecasts.canvas.viewport.zoom_out") },
                data: { action: "forecast-canvas-chart#zoomOut" }
              ) %>
              <%= render DS::Button.new(
                variant: :icon,
                size: :sm,
                icon: "zoom-in",
                type: "button",
                title: t("forecasts.canvas.viewport.zoom_in"),
                aria: { label: t("forecasts.canvas.viewport.zoom_in") },
                data: { action: "forecast-canvas-chart#zoomIn" }
              ) %>
              <%= render DS::Button.new(
                variant: :icon,
                size: :sm,
                icon: "rotate-ccw",
                type: "button",
                title: t("forecasts.canvas.viewport.reset"),
                aria: { label: t("forecasts.canvas.viewport.reset") },
                data: { action: "forecast-canvas-chart#resetZoom" }
              ) %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid min-h-[38rem] lg:grid-cols-[minmax(0,1fr)_24rem]">
      <div class="relative border-b border-primary p-3 lg:border-b-0 lg:border-r sm:p-5">
        <div class="h-[34rem] min-h-96 privacy-sensitive" data-forecast-canvas-chart-target="chart"></div>
      </div>

      <aside class="flex min-h-full flex-col gap-4 p-4" data-forecast-canvas-chart-target="inspector">
        <div data-forecast-canvas-chart-target="draftPanel"></div>

        <section class="space-y-3" aria-labelledby="forecast-canvas-selection-heading">
          <div class="space-y-1">
            <h3 id="forecast-canvas-selection-heading" class="text-primary text-sm font-medium">
              <%= t("forecasts.canvas.selection.heading") %>
            </h3>
            <p class="text-secondary text-xs" data-forecast-canvas-chart-target="selectedDate">
              <%= t("forecasts.canvas.selection.empty") %>
            </p>
          </div>

          <div class="space-y-1">
            <p class="text-secondary text-xs"><%= t("forecasts.canvas.selection.series") %></p>
            <p class="text-primary text-lg font-semibold tabular-nums" data-forecast-canvas-chart-target="selectedValue">--</p>
            <p class="text-secondary text-xs" data-forecast-canvas-chart-target="selectedSeries">--</p>
          </div>
        </section>

        <section class="space-y-3 border-t border-primary pt-4" aria-live="polite" data-forecast-canvas-chart-target="detailPanel"></section>

        <section class="space-y-3 border-t border-primary pt-4" aria-labelledby="forecast-canvas-lines-heading">
          <h3 id="forecast-canvas-lines-heading" class="text-primary text-sm font-medium">
            <%= t("forecasts.canvas.lines_heading") %>
          </h3>
          <div class="space-y-2" data-forecast-canvas-chart-target="legend"></div>
        </section>

        <section class="space-y-3 border-t border-primary pt-4" aria-labelledby="forecast-canvas-events-heading">
          <h3 id="forecast-canvas-events-heading" class="text-primary text-sm font-medium">
            <%= t("forecasts.canvas.events_heading") %>
          </h3>
          <div class="space-y-2" data-forecast-canvas-chart-target="eventList"></div>
        </section>
      </aside>
    </div>

    <% draft_options = @canvas_payload.fetch(:draft_options) %>
    <% amount_effect_types = draft_options.fetch(:amount_effect_types).join(" ") %>
    <% category_effect_types = draft_options.fetch(:category_effect_types).join(" ") %>
    <% transfer_effect_types = draft_options.fetch(:transfer_effect_types).join(" ") %>

    <template data-forecast-canvas-chart-target="draftTemplate">
      <section class="space-y-3 border-b border-primary pb-4" aria-labelledby="forecast-canvas-draft-heading">
        <div class="space-y-1">
          <h3 id="forecast-canvas-draft-heading" class="text-primary text-sm font-medium">
            <%= t("forecasts.canvas.drafts.heading") %>
          </h3>
          <p class="text-secondary text-xs" data-forecast-canvas-chart-draft-date></p>
        </div>

        <form class="space-y-3"
              data-controller="forecast-event-form"
              data-forecast-canvas-chart-target="draftForm"
              data-action="submit->forecast-canvas-chart#saveDraft">
          <div class="space-y-1">
            <label class="text-primary text-sm font-medium" for="canvas-draft-name">
              <%= t("forecasts.canvas.drafts.name") %>
            </label>
            <input id="canvas-draft-name"
                   class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                   name="forecast_event[name]"
                   type="text"
                   required>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <div class="space-y-1">
              <label class="text-primary text-sm font-medium" for="canvas-draft-effect">
                <%= t("forecasts.canvas.drafts.effect") %>
              </label>
              <select id="canvas-draft-effect"
                      class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                      name="forecast_event[effect_type]"
                      data-forecast-event-form-target="effectType"
                      data-action="change->forecast-event-form#refreshEffectType">
                <% draft_options.fetch(:effect_types).each do |effect_type| %>
                  <option value="<%= effect_type %>">
                    <%= t("forecasts.events.effect_types.#{effect_type}", default: effect_type.humanize) %>
                  </option>
                <% end %>
              </select>
            </div>

            <div class="space-y-1">
              <label class="text-primary text-sm font-medium" for="canvas-draft-scenario">
                <%= t("forecasts.canvas.drafts.scenario") %>
              </label>
              <select id="canvas-draft-scenario"
                      class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                      name="forecast_event[scenario_target]"
                      data-action="change->forecast-canvas-chart#refreshDraftScenarioTarget">
                <option value="" data-forecast-canvas-static-scenario-option><%= t("forecasts.canvas.drafts.global") %></option>
                <% draft_options.fetch(:scenario_targets).each do |scenario| %>
                  <option value="<%= scenario.fetch(:id) %>">
                    <%= scenario.fetch(:label) %> (<%= scenario.fetch(:status_label) %>)
                  </option>
                <% end %>
                <option value="<%= draft_options.fetch(:new_scenario_value) %>" data-forecast-canvas-new-scenario-option>
                  <%= t("forecasts.canvas.drafts.new_scenario") %>
                </option>
              </select>
            </div>
          </div>

          <div class="hidden space-y-1" data-forecast-canvas-new-scenario-field>
            <label class="text-primary text-sm font-medium" for="canvas-draft-new-scenario-name">
              <%= t("forecasts.canvas.drafts.new_scenario_name") %>
            </label>
            <input id="canvas-draft-new-scenario-name"
                   class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                   name="forecast_event[new_scenario_name]"
                   type="text"
                   disabled>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <div class="space-y-1">
              <label class="text-primary text-sm font-medium" for="canvas-draft-starts-on">
                <%= t("forecasts.events.form.starts_on_label") %>
              </label>
              <input id="canvas-draft-starts-on"
                     class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                     name="forecast_event[starts_on]"
                     type="date"
                     required
                     data-forecast-canvas-chart-draft-starts-on>
            </div>
          </div>

          <div class="grid gap-3 sm:grid-cols-2"
               data-forecast-event-form-target="field"
               data-forecast-event-form-fields="<%= amount_effect_types %>">
            <div class="space-y-1">
              <label class="text-primary text-sm font-medium" for="canvas-draft-amount">
                <%= t("forecasts.canvas.drafts.amount") %>
              </label>
              <input id="canvas-draft-amount"
                     class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                     name="forecast_event[amount]"
                     type="number"
                     min="0"
                     step="0.01">
            </div>

            <div class="space-y-1">
              <label class="text-primary text-sm font-medium" for="canvas-draft-currency">
                <%= t("forecasts.canvas.drafts.currency") %>
              </label>
              <select id="canvas-draft-currency"
                      class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                      name="forecast_event[currency]">
                <% draft_options.fetch(:currencies).each do |currency| %>
                  <option value="<%= currency %>"><%= currency %></option>
                <% end %>
              </select>
            </div>
          </div>

          <div class="space-y-1"
               data-forecast-event-form-target="field"
               data-forecast-event-form-fields="<%= category_effect_types %>">
            <label class="text-primary text-sm font-medium" for="canvas-draft-category">
              <%= t("forecasts.events.form.category_label") %>
            </label>
            <select id="canvas-draft-category"
                    class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                    name="forecast_event[category_id]">
              <option value=""><%= t("forecasts.events.form.none") %></option>
              <% draft_options.fetch(:categories).each do |category| %>
                <option value="<%= category.fetch(:id) %>"><%= category.fetch(:label) %></option>
              <% end %>
            </select>
          </div>

          <div class="space-y-2"
               data-forecast-event-form-target="field"
               data-forecast-event-form-fields="<%= transfer_effect_types %>">
            <div class="grid gap-3 sm:grid-cols-2">
              <div class="space-y-1">
                <label class="text-primary text-sm font-medium" for="canvas-draft-account">
                  <%= t("forecasts.events.form.account_label") %>
                </label>
                <select id="canvas-draft-account"
                        class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                        name="forecast_event[account_id]">
                  <option value=""><%= t("forecasts.events.form.none") %></option>
                  <% draft_options.fetch(:accounts).each do |account| %>
                    <option value="<%= account.fetch(:id) %>"><%= account.fetch(:label) %></option>
                  <% end %>
                </select>
              </div>

              <div class="space-y-1">
                <label class="text-primary text-sm font-medium" for="canvas-draft-destination-account">
                  <%= t("forecasts.events.form.destination_account_label") %>
                </label>
                <select id="canvas-draft-destination-account"
                        class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                        name="forecast_event[destination_account_id]">
                  <option value=""><%= t("forecasts.events.form.none") %></option>
                  <% draft_options.fetch(:accounts).each do |account| %>
                    <option value="<%= account.fetch(:id) %>"><%= account.fetch(:label) %></option>
                  <% end %>
                </select>
              </div>
            </div>

            <fieldset class="space-y-2 rounded-md border border-primary p-3">
              <legend class="px-1 text-secondary text-xs"><%= t("forecasts.events.form.cross_currency_legend") %></legend>
              <div class="grid gap-3 sm:grid-cols-2">
                <div class="space-y-1">
                  <label class="text-primary text-sm font-medium" for="canvas-draft-destination-amount">
                    <%= t("forecasts.events.form.destination_amount_label") %>
                  </label>
                  <input id="canvas-draft-destination-amount"
                         class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                         name="forecast_event[source_metadata][destination_amount]"
                         type="number"
                         min="0"
                         step="0.01">
                </div>

                <div class="space-y-1">
                  <label class="text-primary text-sm font-medium" for="canvas-draft-destination-currency">
                    <%= t("forecasts.events.form.destination_currency_label") %>
                  </label>
                  <input id="canvas-draft-destination-currency"
                         class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                         name="forecast_event[source_metadata][destination_currency]"
                         type="text"
                         value="<%= @canvas_payload.fetch(:currency) %>">
                </div>
              </div>
            </fieldset>
          </div>

          <div class="space-y-2">
            <label class="flex items-center gap-2 text-primary text-sm">
              <input class="rounded border-primary"
                     name="forecast_event[recurring]"
                     type="checkbox"
                     value="1"
                     data-forecast-event-form-target="recurringToggle"
                     data-action="change->forecast-event-form#refreshRecurrence">
              <%= t("forecasts.events.form.recurring_label") %>
            </label>

            <div class="space-y-2" data-forecast-event-form-target="recurrence">
              <div class="grid gap-3 sm:grid-cols-2">
                <div class="space-y-1">
                  <label class="text-primary text-sm font-medium" for="canvas-draft-frequency">
                    <%= t("forecasts.events.form.frequency_label") %>
                  </label>
                  <select id="canvas-draft-frequency"
                          class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                          name="forecast_event[recurrence_rule][frequency]"
                          data-forecast-event-form-target="frequency"
                          data-action="change->forecast-event-form#refreshFrequency">
                    <% draft_options.fetch(:recurrence_frequencies).each do |frequency| %>
                      <option value="<%= frequency %>"><%= t("forecasts.events.frequencies.#{frequency}") %></option>
                    <% end %>
                  </select>
                </div>

                <div class="space-y-1">
                  <label class="text-primary text-sm font-medium" for="canvas-draft-interval">
                    <%= t("forecasts.events.form.interval_label") %>
                  </label>
                  <input id="canvas-draft-interval"
                         class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                         name="forecast_event[recurrence_rule][interval]"
                         type="number"
                         min="1"
                         max="60"
                         step="1"
                         value="1">
                </div>
              </div>

              <div data-forecast-event-form-target="monthlyField" class="space-y-1">
                <label class="text-primary text-sm font-medium" for="canvas-draft-day-of-month">
                  <%= t("forecasts.events.form.day_of_month_label") %>
                </label>
                <input id="canvas-draft-day-of-month"
                       class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                       name="forecast_event[recurrence_rule][day_of_month]"
                       type="number"
                       min="1"
                       max="31"
                       step="1">
              </div>

              <div data-forecast-event-form-target="endsOn" class="space-y-1">
                <label class="text-primary text-sm font-medium" for="canvas-draft-ends-on">
                  <%= t("forecasts.events.form.ends_on_label") %>
                </label>
                <input id="canvas-draft-ends-on"
                       class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                       name="forecast_event[ends_on]"
                       type="date">
              </div>
            </div>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <div class="space-y-1">
              <label class="text-primary text-sm font-medium" for="canvas-draft-probability">
                <%= t("forecasts.events.form.probability_weight_label") %>
              </label>
              <input id="canvas-draft-probability"
                     class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                     name="forecast_event[probability_weight]"
                     type="number"
                     min="0"
                     max="1"
                     step="0.05"
                     value="1.0">
            </div>

            <div class="space-y-1">
              <label class="text-primary text-sm font-medium" for="canvas-draft-status">
                <%= t("forecasts.events.form.status_label") %>
              </label>
              <select id="canvas-draft-status"
                      class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                      name="forecast_event[status]">
                <% draft_options.fetch(:statuses).each do |status| %>
                  <option value="<%= status %>"><%= t("forecasts.events.statuses.#{status}") %></option>
                <% end %>
              </select>
            </div>
          </div>

          <div class="space-y-1">
            <label class="text-primary text-sm font-medium" for="canvas-draft-description">
              <%= t("forecasts.events.form.description_label") %>
            </label>
            <textarea id="canvas-draft-description"
                      class="w-full rounded-md border border-primary bg-container px-3 py-2 text-primary text-sm"
                      name="forecast_event[description]"
                      rows="2"></textarea>
          </div>

          <div class="hidden rounded-md border border-destructive bg-destructive/10 px-3 py-2 text-destructive text-xs"
               data-forecast-canvas-chart-draft-errors></div>

          <div class="flex justify-end">
            <%= render DS::Button.new(
              text: t("forecasts.canvas.drafts.save"),
              icon: "plus",
              type: "submit"
            ) %>
          </div>
        </form>
      </section>
    </template>
  </section>
</div>
