<% content_for :title, t("forecast.reviews.show.title") %>

<%#
  Review approval surface for ONE forecast run group (the mutable approval
  shell over an immutable run group). Renders deterministic facts + risk flags +
  any stored Hermes response_packet (draft scenarios / recommendations /
  follow-up questions) and lets the user transition the review status. Scoped to
  Current.family via the controller; a cross-family group id is a 404.
%>
<div class="space-y-6 pb-6 lg:pb-12">
  <header class="space-y-2">
    <nav class="text-secondary text-sm" aria-label="<%= t("forecast.reviews.show.back") %>">
      <%= link_to t("forecast.reviews.show.back"), forecast_path(tab: "review"), class: "inline-flex items-center gap-1 hover:text-primary" %>
    </nav>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="space-y-1">
        <h1 class="text-primary text-2xl font-semibold"><%= @run_group.name %></h1>
        <p class="text-secondary text-sm"><%= t("forecast.reviews.show.description") %></p>
      </div>
      <div class="flex items-center gap-2">
        <%= render DS::Pill.new(
          label: t("forecasts.review.run_types.#{@run_group.run_type}", default: @run_group.run_type.humanize),
          tone: :gray,
          show_dot: false
        ) %>
        <%= render DS::Pill.new(
          label: t("forecast.reviews.statuses.#{@review.status}", default: @review.status.humanize),
          tone: review_status_tone(@review.status),
          show_dot: false
        ) %>
      </div>
    </div>
  </header>

  <%= render "forecast/reviews/facts", run_group: @run_group, review: @review %>

  <%= render "forecast/reviews/risk_flags", run_group: @run_group %>

  <%= render "forecast/reviews/hermes", run_group: @run_group, review: @review %>

  <%= render "forecast/reviews/status_controls", run_group: @run_group, review: @review %>
</div>
