<% content_for :title, t("forecasts.budget_plans.index.title") %>

<div class="space-y-6 pb-6 lg:pb-12">
  <header class="flex flex-wrap items-center justify-between gap-3">
    <div class="space-y-1">
      <h1 class="text-primary text-2xl font-semibold"><%= t("forecasts.budget_plans.index.title") %></h1>
      <p class="text-secondary text-sm"><%= t("forecasts.budget_plans.index.description") %></p>
    </div>

    <%= render DS::Link.new(
      text: t("forecasts.budget_plans.index.new"),
      icon: "plus",
      href: new_forecast_budget_plan_path
    ) %>
  </header>

  <section class="space-y-3" aria-labelledby="forecast-budget-plans-heading">
    <div class="flex items-center justify-between gap-3">
      <h2 id="forecast-budget-plans-heading" class="text-primary text-base font-medium"><%= t("forecasts.budget_plans.index.plans_heading") %></h2>
      <p class="text-secondary text-sm"><%= t("forecasts.budget_plans.index.plan_count", count: @plans.size) %></p>
    </div>

    <% if @plans.any? %>
      <div class="divide-y divide-primary rounded-xl border border-primary bg-container overflow-hidden">
        <% @plans.each do |plan| %>
          <article class="p-4" data-testid="forecast-budget-plan">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0 space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-primary text-sm font-medium"><%= plan.forecast_scenario.name %></h3>
                  <%= render DS::Pill.new(
                    label: t("forecasts.scenarios.statuses.#{plan.forecast_scenario.status}"),
                    tone: plan.forecast_scenario.active? ? :indigo : :gray,
                    show_dot: false
                  ) %>
                </div>
                <% if plan.forecast_scenario.description.present? %>
                  <p class="text-secondary text-sm line-clamp-2"><%= plan.forecast_scenario.description %></p>
                <% end %>
                <p class="text-secondary text-xs">
                  <%= t("forecasts.budget_plans.index.timeline",
                        start_date: l(plan.horizon_start_on, format: :long),
                        end_date: l(plan.horizon_end_on, format: :long),
                        count: plan.forecast_budget_plan_amounts.size) %>
                </p>
              </div>

              <div class="flex flex-wrap items-center gap-2">
                <%= render DS::Link.new(
                  text: t("forecasts.budget_plans.index.edit"),
                  icon: "sliders-horizontal",
                  href: edit_forecast_budget_plan_path(plan),
                  variant: "outline",
                  size: :sm
                ) %>
                <%= render DS::Button.new(
                  text: t("forecasts.budget_plans.index.duplicate"),
                  icon: "copy",
                  href: duplicate_forecast_budget_plan_path(plan),
                  method: :post,
                  variant: "ghost",
                  size: :sm
                ) %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-xl border border-primary bg-container p-5">
        <p class="text-primary text-sm font-medium"><%= t("forecasts.budget_plans.index.empty_title") %></p>
        <p class="mt-1 text-secondary text-sm"><%= t("forecasts.budget_plans.index.empty_body") %></p>
      </div>
    <% end %>
  </section>

  <section class="space-y-3" aria-labelledby="forecast-budget-templates-heading">
    <div class="flex items-center justify-between gap-3">
      <h2 id="forecast-budget-templates-heading" class="text-primary text-base font-medium"><%= t("forecasts.budget_templates.index.title") %></h2>
      <p class="text-secondary text-sm"><%= t("forecasts.budget_templates.index.template_count", count: @templates.size) %></p>
    </div>

    <% if @templates.any? %>
      <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
        <% @templates.each do |template| %>
          <article class="rounded-xl border border-primary bg-container p-4" data-testid="forecast-budget-template">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="text-primary text-sm font-medium"><%= template.name %></h3>
                <% if template.description.present? %>
                  <p class="mt-1 text-secondary text-sm line-clamp-2"><%= template.description %></p>
                <% end %>
                <p class="mt-2 text-secondary text-xs">
                  <%= t("forecasts.budget_templates.index.amount_count", count: template.forecast_budget_template_amounts.size) %>
                </p>
              </div>
              <div class="flex shrink-0 items-center gap-2">
                <%= render DS::Button.new(
                  text: t("forecasts.budget_templates.index.apply"),
                  icon: "file-plus-2",
                  href: apply_forecast_budget_template_path(template),
                  method: :post,
                  size: :sm
                ) %>
                <%= render DS::Button.new(
                  text: t("forecasts.budget_templates.index.copy"),
                  icon: "copy",
                  href: duplicate_forecast_budget_template_path(template),
                  method: :post,
                  variant: "ghost",
                  size: :sm
                ) %>
                <%= render DS::Button.new(
                  text: t("forecasts.budget_templates.index.delete"),
                  icon: "trash-2",
                  href: forecast_budget_template_path(template),
                  method: :delete,
                  variant: "outline_destructive",
                  size: :sm
                ) %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-xl border border-primary bg-container p-5">
        <p class="text-primary text-sm font-medium"><%= t("forecasts.budget_templates.index.empty_title") %></p>
        <p class="mt-1 text-secondary text-sm"><%= t("forecasts.budget_templates.index.empty_body") %></p>
      </div>
    <% end %>
  </section>

  <div class="border-t border-primary pt-4">
    <%= render DS::Link.new(
      text: t("forecasts.budget_plans.index.legacy_overrides"),
      icon: "table-2",
      href: forecast_budget_overrides_path,
      variant: "outline",
      size: :sm
    ) %>
  </div>
</div>
