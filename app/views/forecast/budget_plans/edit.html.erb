<% content_for :title, t("forecasts.budget_plans.edit.title") %>

<%
  activation = @plan.activation_metadata || {}
  dependencies = @plan.dependency_metadata || {}
  depends_on = dependencies.fetch("depends_on", {})
  dependents = dependencies.fetch("dependents", {})
%>

<div class="space-y-6 pb-6 lg:pb-12" data-controller="forecast-budget-plan-form">
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div class="space-y-1">
      <h1 class="text-primary text-2xl font-semibold"><%= t("forecasts.budget_plans.edit.title") %></h1>
      <p class="text-secondary text-sm"><%= t("forecasts.budget_plans.edit.description") %></p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <%= render DS::Button.new(
        text: t("forecasts.budget_plans.edit.copy"),
        icon: "copy",
        href: duplicate_forecast_budget_plan_path(@plan),
        method: :post,
        variant: "outline"
      ) %>
      <%= render DS::Button.new(
        text: t("forecasts.budget_plans.edit.save_template"),
        icon: "save",
        href: create_template_forecast_budget_plan_path(@plan, period: Budget.date_to_param(@period_start_on)),
        method: :post,
        variant: "outline"
      ) %>
    </div>
  </header>

  <% if @errors.present? %>
    <div class="rounded-lg border border-destructive bg-destructive/10 p-4">
      <p class="text-primary text-sm font-medium"><%= t("forecasts.budget_plans.form.errors") %></p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-secondary">
        <% @errors.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @plan,
                url: forecast_budget_plan_path(@plan, period: Budget.date_to_param(@period_start_on)),
                scope: :forecast_budget_plan,
                method: :patch,
                class: "space-y-6" do |f| %>
    <section class="grid grid-cols-1 gap-4 xl:grid-cols-[minmax(0,1fr)_22rem]">
      <div class="space-y-4 rounded-xl border border-primary bg-container p-4">
        <div class="space-y-1">
          <h2 class="text-primary text-base font-medium"><%= t("forecasts.budget_plans.form.scenario_heading") %></h2>
          <p class="text-secondary text-sm"><%= t("forecasts.budget_plans.form.scenario_description") %></p>
        </div>

        <div class="space-y-3">
          <div>
            <%= f.label :name, t("forecasts.budget_plans.form.name_label"), class: "form-field__label" %>
            <%= f.text_field :name, value: @plan.forecast_scenario.name, required: true, class: "form-field__input" %>
          </div>

          <div>
            <%= f.label :description, t("forecasts.budget_plans.form.description_label"), class: "form-field__label" %>
            <%= f.text_area :description, value: @plan.forecast_scenario.description, rows: 4, class: "form-field__input" %>
          </div>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div>
              <%= f.label :status, t("forecasts.budget_plans.form.status_label"), class: "form-field__label" %>
              <%= f.select :status,
                           ForecastScenario::STATUSES.map { |status| [ t("forecasts.scenarios.statuses.#{status}"), status ] },
                           { selected: @plan.forecast_scenario.status },
                           class: "form-field__input" %>
            </div>
            <div>
              <%= f.label :starts_on, t("forecasts.budget_plans.form.starts_on_label"), class: "form-field__label" %>
              <%= f.date_field :starts_on, value: @plan.forecast_scenario.starts_on, class: "form-field__input" %>
            </div>
            <div>
              <%= f.label :ends_on, t("forecasts.budget_plans.form.ends_on_label"), class: "form-field__label" %>
              <%= f.date_field :ends_on, value: @plan.forecast_scenario.ends_on, class: "form-field__input" %>
            </div>
          </div>
        </div>
      </div>

      <aside class="space-y-4 rounded-xl border border-primary bg-container p-4">
        <div class="space-y-1">
          <h2 class="text-primary text-base font-medium"><%= t("forecasts.budget_plans.form.timeline_heading") %></h2>
          <p class="text-secondary text-sm"><%= t("forecasts.budget_plans.form.timeline_description") %></p>
        </div>

        <div class="space-y-3">
          <div>
            <%= f.label :base_period_start_on, t("forecasts.budget_plans.form.base_period_label"), class: "form-field__label" %>
            <%= f.date_field :base_period_start_on, value: @plan.base_period_start_on, class: "form-field__input" %>
          </div>
          <div>
            <%= f.label :horizon_start_on, t("forecasts.budget_plans.form.horizon_start_label"), class: "form-field__label" %>
            <%= f.date_field :horizon_start_on, value: @plan.horizon_start_on, class: "form-field__input" %>
          </div>
          <div>
            <%= f.label :horizon_end_on, t("forecasts.budget_plans.form.horizon_end_label"), class: "form-field__label" %>
            <%= f.date_field :horizon_end_on, value: @plan.horizon_end_on, class: "form-field__input" %>
          </div>
        </div>
      </aside>
    </section>

    <section class="space-y-4 rounded-xl border border-primary bg-container p-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="space-y-1">
          <h2 class="text-primary text-base font-medium"><%= t("forecasts.budget_plans.editor.heading") %></h2>
          <p class="text-secondary text-sm"><%= t("forecasts.budget_plans.editor.description") %></p>
        </div>

        <nav class="flex items-center gap-2" aria-label="<%= t("forecasts.budget_plans.editor.period_nav_label") %>">
          <%= render DS::Link.new(
            variant: "icon",
            icon: "chevron-left",
            href: edit_forecast_budget_plan_path(@plan, period: Budget.date_to_param(@period_start_on - 1.month))
          ) %>
          <span class="text-primary text-sm font-medium tabular-nums" data-testid="forecast-budget-plan-period">
            <%= l(@period_start_on, format: :long) %> - <%= l(@period_end_on, format: :long) %>
          </span>
          <%= render DS::Link.new(
            variant: "icon",
            icon: "chevron-right",
            href: edit_forecast_budget_plan_path(@plan, period: Budget.date_to_param(@period_start_on + 1.month))
          ) %>
        </nav>
      </div>

      <div class="overflow-x-auto rounded-lg border border-primary">
        <table class="w-full min-w-max text-sm">
          <caption class="sr-only"><%= t("forecasts.budget_plans.editor.caption") %></caption>
          <thead>
            <tr class="border-b border-primary text-left text-xs uppercase tracking-wide text-secondary">
              <th scope="col" class="px-4 py-3 font-medium"><%= t("forecasts.budget_plans.editor.row_label") %></th>
              <th scope="col" class="px-4 py-3 text-right font-medium"><%= t("forecasts.budget_plans.editor.inherited") %></th>
              <th scope="col" class="px-4 py-3 font-medium"><%= t("forecasts.budget_plans.editor.forecast") %></th>
              <th scope="col" class="px-4 py-3 font-medium"><%= t("forecasts.budget_plans.editor.slider") %></th>
              <th scope="col" class="px-4 py-3 font-medium"><%= t("forecasts.budget_plans.editor.status") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary">
            <% @rows.each do |row| %>
              <% row_key = row.fetch(:key) %>
              <tr id="forecast_budget_plan_<%= row_key %>_row">
                <th scope="row" class="px-4 py-3 text-left font-medium text-primary">
                  <%= row.fetch(:label) %>
                </th>
                <td class="px-4 py-3 text-right text-secondary tabular-nums">
                  <% if row.fetch(:inherited_amount).present? %>
                    <%= Money.new(row.fetch(:inherited_amount), @plan.currency).format %>
                  <% else %>
                    <span aria-label="<%= t("forecasts.budget_plans.editor.no_inherited") %>">-</span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <%= hidden_field_tag "forecast_budget_plan[amounts][#{row_key}][amount_type]", row.fetch(:amount_type) %>
                  <%= hidden_field_tag "forecast_budget_plan[amounts][#{row_key}][category_id]", row.fetch(:category)&.id %>
                  <%= number_field_tag "forecast_budget_plan[amounts][#{row_key}][amount]",
                                       row.fetch(:value),
                                       min: 0,
                                       step: 1,
                                       class: "form-field__input w-32 text-right tabular-nums",
                                       data: {
                                         forecast_budget_plan_form_target: "amount",
                                         row_key: row_key,
                                         action: "input->forecast-budget-plan-form#syncSlider"
                                       } %>
                </td>
                <td class="px-4 py-3">
                  <%= range_field_tag "forecast_budget_plan_amount_slider_#{row_key}",
                                      row.fetch(:value),
                                      min: 0,
                                      max: row.fetch(:slider_max),
                                      step: 50,
                                      class: "w-full min-w-44",
                                      data: {
                                        forecast_budget_plan_form_target: "slider",
                                        row_key: row_key,
                                        action: "input->forecast-budget-plan-form#syncAmount"
                                      } %>
                </td>
                <td class="px-4 py-3 text-secondary text-xs">
                  <% if row.fetch(:exact_amount).present? %>
                    <%= t("forecasts.budget_plans.editor.changed_here") %>
                  <% elsif row.fetch(:effective_amount).present? %>
                    <%= t("forecasts.budget_plans.editor.projected_forward") %>
                  <% else %>
                    <%= t("forecasts.budget_plans.editor.inherited_status") %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="grid grid-cols-1 gap-4 xl:grid-cols-2">
      <div class="space-y-4 rounded-xl border border-primary bg-container p-4">
        <div class="space-y-1">
          <h2 class="text-primary text-base font-medium"><%= t("forecasts.budget_plans.form.activation_heading") %></h2>
          <p class="text-secondary text-sm"><%= t("forecasts.budget_plans.form.activation_description") %></p>
        </div>
        <div class="space-y-3">
          <div>
            <%= f.label :activation_trigger, t("forecasts.budget_plans.form.activation_trigger_label"), class: "form-field__label" %>
            <%= f.text_field :activation_trigger, value: activation["trigger"], class: "form-field__input" %>
          </div>
          <div>
            <%= f.label :activation_conditions, t("forecasts.budget_plans.form.activation_conditions_label"), class: "form-field__label" %>
            <%= f.text_area :activation_conditions, value: activation["conditions"], rows: 3, class: "form-field__input" %>
          </div>
        </div>
      </div>

      <div class="space-y-4 rounded-xl border border-primary bg-container p-4">
        <div class="space-y-1">
          <h2 class="text-primary text-base font-medium"><%= t("forecasts.budget_plans.form.dependencies_heading") %></h2>
          <p class="text-secondary text-sm"><%= t("forecasts.budget_plans.form.dependencies_description") %></p>
        </div>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <label class="form-field__label" for="forecast_budget_plan_depends_on_scenario_ids"><%= t("forecasts.budget_plans.form.depends_on_scenarios_label") %></label>
            <%= select_tag "forecast_budget_plan[depends_on_scenario_ids][]",
                           options_from_collection_for_select(@scenario_dependency_options, :id, :name, depends_on.fetch("forecast_scenario_ids", [])),
                           multiple: true,
                           id: "forecast_budget_plan_depends_on_scenario_ids",
                           class: "form-field__input min-h-24" %>
          </div>
          <div>
            <label class="form-field__label" for="forecast_budget_plan_depends_on_goal_ids"><%= t("forecasts.budget_plans.form.depends_on_goals_label") %></label>
            <%= select_tag "forecast_budget_plan[depends_on_goal_ids][]",
                           options_from_collection_for_select(@goal_dependency_options, :id, :name, depends_on.fetch("forecast_goal_ids", [])),
                           multiple: true,
                           id: "forecast_budget_plan_depends_on_goal_ids",
                           class: "form-field__input min-h-24" %>
          </div>
          <div>
            <label class="form-field__label" for="forecast_budget_plan_depended_on_by_scenario_ids"><%= t("forecasts.budget_plans.form.depended_on_by_scenarios_label") %></label>
            <%= select_tag "forecast_budget_plan[depended_on_by_scenario_ids][]",
                           options_from_collection_for_select(@scenario_dependency_options, :id, :name, dependents.fetch("forecast_scenario_ids", [])),
                           multiple: true,
                           id: "forecast_budget_plan_depended_on_by_scenario_ids",
                           class: "form-field__input min-h-24" %>
          </div>
          <div>
            <label class="form-field__label" for="forecast_budget_plan_depended_on_by_goal_ids"><%= t("forecasts.budget_plans.form.depended_on_by_goals_label") %></label>
            <%= select_tag "forecast_budget_plan[depended_on_by_goal_ids][]",
                           options_from_collection_for_select(@goal_dependency_options, :id, :name, dependents.fetch("forecast_goal_ids", [])),
                           multiple: true,
                           id: "forecast_budget_plan_depended_on_by_goal_ids",
                           class: "form-field__input min-h-24" %>
          </div>
        </div>
      </div>
    </section>

    <div class="flex items-center justify-end gap-2">
      <%= render DS::Link.new(
        text: t("forecasts.budget_plans.form.cancel"),
        href: forecast_budget_plans_path,
        variant: "outline"
      ) %>
      <%= f.submit t("forecasts.budget_plans.form.update"), class: "btn btn--primary" %>
    </div>
  <% end %>
</div>
