<% content_for :title, t("forecasts.budget_plans.edit.title") %>

<%
  activation = @plan.activation_metadata || {}
  dependencies = @plan.dependency_metadata || {}
  depends_on = dependencies.fetch("depends_on", {})
  dependents = dependencies.fetch("dependents", {})
%>

<div class="pb-6 lg:pb-12"
     data-controller="forecast-budget-plan-form"
     data-forecast-budget-plan-form-currency-value="<%= @plan.currency %>">
  <header class="mb-5 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl space-y-2">
      <p class="text-secondary text-xs font-medium uppercase tracking-wide"><%= t("forecasts.budget_plans.edit.eyebrow") %></p>
      <div class="space-y-1">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-primary text-2xl font-semibold"><%= @plan.forecast_scenario.name %></h1>
          <%= render DS::Pill.new(
            label: t("forecasts.scenarios.statuses.#{@plan.forecast_scenario.status}"),
            tone: @plan.forecast_scenario.active? ? :indigo : :gray,
            show_dot: false
          ) %>
        </div>
        <p class="text-secondary text-sm"><%= @plan.forecast_scenario.description.presence || t("forecasts.budget_plans.edit.description") %></p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <%= render DS::Button.new(
        text: t("forecasts.budget_plans.edit.copy"),
        icon: "copy",
        href: duplicate_forecast_budget_plan_path(@plan),
        method: :post,
        variant: "outline",
        size: :sm
      ) %>
      <%= render DS::Button.new(
        text: t("forecasts.budget_plans.edit.save_template"),
        icon: "save",
        type: "submit",
        form: "forecast_budget_plan_form",
        name: "commit",
        value: "save_template",
        variant: "outline",
        size: :sm
      ) %>
      <%= render DS::Button.new(
        text: t("forecasts.budget_plans.edit.delete"),
        icon: "trash-2",
        href: forecast_budget_plan_path(@plan),
        method: :delete,
        variant: "outline_destructive",
        size: :sm,
        confirm: CustomConfirm.for_resource_deletion(@plan.forecast_scenario.name)
      ) %>
    </div>
  </header>

  <% if @errors.present? %>
    <div class="mb-4 rounded-lg border border-destructive bg-destructive/10 p-4">
      <p class="text-primary text-sm font-medium"><%= t("forecasts.budget_plans.form.errors") %></p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-secondary">
        <% @errors.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @plan,
                url: forecast_budget_plan_path(@plan, period: Budget.date_to_param(@period_start_on)),
                scope: :forecast_budget_plan,
                method: :patch,
                id: "forecast_budget_plan_form",
                class: "space-y-5" do |f| %>
    <div class="grid gap-5 2xl:grid-cols-[minmax(0,1fr)_24rem]">
      <main class="min-w-0 space-y-5">
        <section class="overflow-hidden rounded-xl border border-primary bg-container" aria-labelledby="forecast-budget-values-heading">
          <div class="border-b border-primary p-4">
            <div class="flex flex-col gap-4">
              <div class="space-y-1">
                <h2 id="forecast-budget-values-heading" class="text-primary text-base font-medium"><%= t("forecasts.budget_plans.editor.heading") %></h2>
                <p class="text-secondary text-sm"><%= t("forecasts.budget_plans.editor.description") %></p>
              </div>

              <%
                previous_period_start = @family.custom_month_start_for(@period_start_on - 1.month)
                next_period_start = @family.custom_month_start_for(@period_start_on + 1.month)
                previous_period_available = previous_period_start >= @plan.horizon_start_on
                next_period_available = @family.custom_month_end_for(next_period_start) <= @plan.horizon_end_on
              %>
              <nav class="flex shrink-0 items-center gap-2" aria-label="<%= t("forecasts.budget_plans.editor.period_nav_label") %>">
                <% if previous_period_available %>
                  <%= render DS::Link.new(
                    variant: "icon",
                    icon: "chevron-left",
                    href: edit_forecast_budget_plan_path(@plan, period: Budget.date_to_param(previous_period_start)),
                    aria: { label: t("forecasts.budget_plans.editor.previous_month") }
                  ) %>
                <% else %>
                  <%= render DS::Button.new(
                    variant: "icon",
                    icon: "chevron-left",
                    type: "button",
                    disabled: true,
                    aria: { label: t("forecasts.budget_plans.editor.previous_month") }
                  ) %>
                <% end %>
                <span class="min-w-52 text-center text-primary text-sm font-medium tabular-nums" data-testid="forecast-budget-plan-period">
                  <%= t("forecasts.budget_plans.editor.period_range",
                        start_date: l(@period_start_on, format: :long),
                        end_date: l(@period_end_on, format: :long)) %>
                </span>
                <% if next_period_available %>
                  <%= render DS::Link.new(
                    variant: "icon",
                    icon: "chevron-right",
                    href: edit_forecast_budget_plan_path(@plan, period: Budget.date_to_param(next_period_start)),
                    aria: { label: t("forecasts.budget_plans.editor.next_month") }
                  ) %>
                <% else %>
                  <%= render DS::Button.new(
                    variant: "icon",
                    icon: "chevron-right",
                    type: "button",
                    disabled: true,
                    aria: { label: t("forecasts.budget_plans.editor.next_month") }
                  ) %>
                <% end %>
              </nav>
            </div>
          </div>

          <div class="grid grid-cols-2 border-b border-primary bg-surface text-sm 2xl:grid-cols-4">
            <div class="border-b border-r border-primary p-4 2xl:border-b-0">
              <p class="text-secondary text-xs"><%= t("forecasts.budget_plans.editor.income_total") %></p>
              <p class="mt-1 text-primary text-lg font-semibold tabular-nums" data-forecast-budget-plan-form-target="incomeTotal">
                <%= Money.new(@budget_plan_summary.fetch(:income), @plan.currency).format(no_cents_if_whole: true) %>
              </p>
            </div>
            <div class="border-b border-primary p-4 2xl:border-b-0 2xl:border-r">
              <p class="text-secondary text-xs"><%= t("forecasts.budget_plans.editor.spending_total") %></p>
              <p class="mt-1 text-primary text-lg font-semibold tabular-nums" data-forecast-budget-plan-form-target="spendingTotal">
                <%= Money.new(@budget_plan_summary.fetch(:spending), @plan.currency).format(no_cents_if_whole: true) %>
              </p>
            </div>
            <div class="border-r border-primary p-4 2xl:border-r">
              <p class="text-secondary text-xs"><%= t("forecasts.budget_plans.editor.net_total") %></p>
              <p class="mt-1 text-primary text-lg font-semibold tabular-nums" data-forecast-budget-plan-form-target="netTotal">
                <%= Money.new(@budget_plan_summary.fetch(:net), @plan.currency).format(no_cents_if_whole: true) %>
              </p>
            </div>
            <div class="p-4">
              <p class="text-secondary text-xs"><%= t("forecasts.budget_plans.editor.rows_total") %></p>
              <p class="mt-1 text-primary text-lg font-semibold tabular-nums">
                <%= t("forecasts.budget_plans.editor.rows_summary",
                      changed: @budget_plan_summary.fetch(:changed_count),
                      projected: @budget_plan_summary.fetch(:projected_count)) %>
              </p>
            </div>
          </div>

          <div role="list" aria-label="<%= t("forecasts.budget_plans.editor.caption") %>">
            <% @rows.each do |row| %>
              <% row_key = row.fetch(:key) %>
              <% row_label = row.fetch(:label) %>
              <div id="forecast_budget_plan_<%= row_key %>_row" class="border-t border-primary p-4 first:border-t-0 hover:bg-surface-hover" role="listitem">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="text-primary text-sm font-medium"><%= row_label %></p>
                    <p class="mt-1 text-secondary text-xs tabular-nums">
                      <%= t("forecasts.budget_plans.editor.inherited") %>:
                      <% if row.fetch(:inherited_amount).present? %>
                        <%= Money.new(row.fetch(:inherited_amount), @plan.currency).format(no_cents_if_whole: true) %>
                      <% else %>
                        <span aria-label="<%= t("forecasts.budget_plans.editor.no_inherited") %>">-</span>
                      <% end %>
                    </p>
                  </div>

                  <div class="text-secondary text-xs">
                    <% if row.fetch(:exact_amount).present? %>
                      <%= render DS::Pill.new(label: t("forecasts.budget_plans.editor.changed_here"), tone: :indigo, show_dot: false) %>
                    <% elsif row.fetch(:effective_amount).present? %>
                      <%= t("forecasts.budget_plans.editor.projected_forward") %>
                    <% else %>
                      <%= t("forecasts.budget_plans.editor.inherited_status") %>
                    <% end %>
                  </div>
                </div>

                <div class="mt-3 grid grid-cols-[7.5rem_minmax(0,1fr)] items-center gap-3">
                  <div>
                    <label class="sr-only" for="forecast_budget_plan_amount_<%= row_key %>"><%= t("forecasts.budget_plans.editor.forecast_amount_label", label: row_label) %></label>
                    <%= hidden_field_tag "forecast_budget_plan[amounts][#{row_key}][amount_type]", row.fetch(:amount_type) %>
                    <%= hidden_field_tag "forecast_budget_plan[amounts][#{row_key}][category_id]", row.fetch(:category)&.id %>
                    <%= hidden_field_tag "forecast_budget_plan[amounts][#{row_key}][mode]",
                                         row.fetch(:mode),
                                         data: {
                                           forecast_budget_plan_form_target: "mode",
                                           row_key: row_key,
                                           original_mode: row.fetch(:mode)
                                         } %>
                    <%= hidden_field_tag "forecast_budget_plan[amounts][#{row_key}][original_amount]", row.fetch(:input_value) %>
                    <%= number_field_tag "forecast_budget_plan[amounts][#{row_key}][amount]",
                                         row.fetch(:input_value),
                                         min: 0,
                                         step: 1,
                                         autocomplete: "off",
                                         id: "forecast_budget_plan_amount_#{row_key}",
                                         class: "form-field__input h-9 rounded-md bg-container-inset px-2 text-right tabular-nums",
                                         data: {
                                           forecast_budget_plan_form_target: "amount",
                                           row_key: row_key,
                                           original_amount: row.fetch(:input_value),
                                           amount_type: row.fetch(:amount_type),
                                           action: "input->forecast-budget-plan-form#syncSlider"
                                         } %>
                  </div>
                  <div>
                    <label class="sr-only" for="forecast_budget_plan_amount_slider_<%= row_key %>"><%= t("forecasts.budget_plans.editor.slider_label", label: row_label) %></label>
                    <%= range_field_tag "forecast_budget_plan_amount_slider_#{row_key}",
                                        row.fetch(:input_value),
                                        min: 0,
                                        max: row.fetch(:slider_max),
                                        step: 50,
                                        id: "forecast_budget_plan_amount_slider_#{row_key}",
                                        class: "h-2 w-full cursor-pointer",
                                        data: {
                                          forecast_budget_plan_form_target: "slider",
                                          row_key: row_key,
                                          action: "input->forecast-budget-plan-form#syncAmount"
                                        } %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </section>
      </main>

      <aside class="space-y-4 2xl:sticky 2xl:top-4 2xl:self-start">
        <section class="rounded-xl border border-primary bg-container p-4">
          <div class="mb-4 flex items-center justify-between gap-3">
            <h2 class="text-primary text-base font-medium"><%= t("forecasts.budget_plans.edit.details_heading") %></h2>
            <%= render DS::Pill.new(label: t("forecasts.budget_plans.edit.scenario_backed"), tone: :indigo, show_dot: false) %>
          </div>

          <div class="space-y-4">
            <div>
              <%= f.label :name, t("forecasts.budget_plans.form.name_label"), class: "form-field__label" %>
              <%= f.text_field :name, value: @plan.forecast_scenario.name, required: true, class: "form-field__input" %>
            </div>

            <div>
              <%= f.label :description, t("forecasts.budget_plans.form.description_label"), class: "form-field__label" %>
              <%= f.text_area :description, value: @plan.forecast_scenario.description, rows: 4, class: "form-field__input" %>
            </div>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 2xl:grid-cols-1">
              <div>
                <%= f.label :status, t("forecasts.budget_plans.form.status_label"), class: "form-field__label" %>
                <%= f.select :status,
                             ForecastScenario::STATUSES.map { |status| [ t("forecasts.scenarios.statuses.#{status}"), status ] },
                             { selected: @plan.forecast_scenario.status },
                             class: "form-field__input" %>
              </div>
              <div>
                <%= f.label :starts_on, t("forecasts.budget_plans.form.starts_on_label"), class: "form-field__label" %>
                <%= f.date_field :starts_on, value: @plan.forecast_scenario.starts_on, class: "form-field__input" %>
              </div>
              <div>
                <%= f.label :ends_on, t("forecasts.budget_plans.form.ends_on_label"), class: "form-field__label" %>
                <%= f.date_field :ends_on, value: @plan.forecast_scenario.ends_on, class: "form-field__input" %>
              </div>
            </div>
          </div>
        </section>

        <details open class="group rounded-xl border border-primary bg-container p-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-primary text-base font-medium">
            <span><%= t("forecasts.budget_plans.form.timeline_heading") %></span>
            <%= icon "chevron-down", size: "sm", class: "text-secondary transition-transform group-open:rotate-180" %>
          </summary>
          <p class="mt-2 text-secondary text-sm"><%= t("forecasts.budget_plans.form.timeline_description") %></p>
          <div class="mt-4 space-y-4">
            <div>
              <%= f.label :base_period_start_on, t("forecasts.budget_plans.form.base_period_label"), class: "form-field__label" %>
              <%= f.date_field :base_period_start_on, value: @plan.base_period_start_on, class: "form-field__input" %>
            </div>
            <div>
              <%= f.label :horizon_start_on, t("forecasts.budget_plans.form.horizon_start_label"), class: "form-field__label" %>
              <%= f.date_field :horizon_start_on, value: @plan.horizon_start_on, class: "form-field__input" %>
            </div>
            <div>
              <%= f.label :horizon_end_on, t("forecasts.budget_plans.form.horizon_end_label"), class: "form-field__label" %>
              <%= f.date_field :horizon_end_on, value: @plan.horizon_end_on, class: "form-field__input" %>
            </div>
          </div>
        </details>

        <details class="group rounded-xl border border-primary bg-container p-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-primary text-base font-medium">
            <span><%= t("forecasts.budget_plans.form.activation_heading") %></span>
            <%= icon "chevron-down", size: "sm", class: "text-secondary transition-transform group-open:rotate-180" %>
          </summary>
          <p class="mt-2 text-secondary text-sm"><%= t("forecasts.budget_plans.form.activation_description") %></p>
          <div class="mt-4 space-y-4">
            <div>
              <%= f.label :activation_trigger, t("forecasts.budget_plans.form.activation_trigger_label"), class: "form-field__label" %>
              <%= f.text_field :activation_trigger, value: activation["trigger"], class: "form-field__input" %>
            </div>
            <div>
              <%= f.label :activation_conditions, t("forecasts.budget_plans.form.activation_conditions_label"), class: "form-field__label" %>
              <%= f.text_area :activation_conditions, value: activation["conditions"], rows: 3, class: "form-field__input" %>
            </div>
          </div>
        </details>

        <details class="group rounded-xl border border-primary bg-container p-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-primary text-base font-medium">
            <span><%= t("forecasts.budget_plans.form.dependencies_heading") %></span>
            <%= icon "chevron-down", size: "sm", class: "text-secondary transition-transform group-open:rotate-180" %>
          </summary>
          <p class="mt-2 text-secondary text-sm"><%= t("forecasts.budget_plans.form.dependencies_description") %></p>
          <div class="mt-4 grid grid-cols-1 gap-4">
            <div>
              <label class="form-field__label" for="forecast_budget_plan_depends_on_scenario_ids"><%= t("forecasts.budget_plans.form.depends_on_scenarios_label") %></label>
              <%= select_tag "forecast_budget_plan[depends_on_scenario_ids][]",
                             options_from_collection_for_select(@scenario_dependency_options, :id, :name, depends_on.fetch("forecast_scenario_ids", [])),
                             multiple: true,
                             id: "forecast_budget_plan_depends_on_scenario_ids",
                             class: "form-field__input min-h-24" %>
            </div>
            <div>
              <label class="form-field__label" for="forecast_budget_plan_depends_on_goal_ids"><%= t("forecasts.budget_plans.form.depends_on_goals_label") %></label>
              <%= select_tag "forecast_budget_plan[depends_on_goal_ids][]",
                             options_from_collection_for_select(@goal_dependency_options, :id, :name, depends_on.fetch("forecast_goal_ids", [])),
                             multiple: true,
                             id: "forecast_budget_plan_depends_on_goal_ids",
                             class: "form-field__input min-h-24" %>
            </div>
            <div>
              <label class="form-field__label" for="forecast_budget_plan_depended_on_by_scenario_ids"><%= t("forecasts.budget_plans.form.depended_on_by_scenarios_label") %></label>
              <%= select_tag "forecast_budget_plan[depended_on_by_scenario_ids][]",
                             options_from_collection_for_select(@scenario_dependency_options, :id, :name, dependents.fetch("forecast_scenario_ids", [])),
                             multiple: true,
                             id: "forecast_budget_plan_depended_on_by_scenario_ids",
                             class: "form-field__input min-h-24" %>
            </div>
            <div>
              <label class="form-field__label" for="forecast_budget_plan_depended_on_by_goal_ids"><%= t("forecasts.budget_plans.form.depended_on_by_goals_label") %></label>
              <%= select_tag "forecast_budget_plan[depended_on_by_goal_ids][]",
                             options_from_collection_for_select(@goal_dependency_options, :id, :name, dependents.fetch("forecast_goal_ids", [])),
                             multiple: true,
                             id: "forecast_budget_plan_depended_on_by_goal_ids",
                             class: "form-field__input min-h-24" %>
            </div>
          </div>
        </details>
      </aside>
    </div>

    <div class="sticky bottom-0 z-10 flex items-center justify-end gap-2 border-t border-primary bg-container py-4">
      <%= render DS::Link.new(
        text: t("forecasts.budget_plans.form.cancel"),
        href: forecast_budget_plans_path,
        variant: "outline"
      ) %>
      <%= f.submit t("forecasts.budget_plans.form.update"), class: "btn btn--primary" %>
    </div>
  <% end %>
</div>
