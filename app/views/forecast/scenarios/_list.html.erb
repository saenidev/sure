<%# locals: (scenario_groups:) %>

<% total = scenario_groups.values.sum(&:size) %>

<% if total.zero? %>
  <div class="rounded-xl border border-primary bg-container p-8 text-center space-y-3"
       data-testid="scenarios-empty-state">
    <div class="mx-auto w-fit text-secondary">
      <%= icon "layers", size: "xl" %>
    </div>
    <h3 class="text-primary text-base font-medium"><%= t("forecasts.scenarios.empty.title") %></h3>
    <p class="text-secondary text-sm max-w-md mx-auto"><%= t("forecasts.scenarios.empty.body") %></p>
    <div class="pt-1">
      <%= render DS::Button.new(
        text: t("forecasts.scenarios.index.new"),
        icon: "plus",
        href: new_forecast_scenario_path,
        frame: "modal"
      ) %>
    </div>
  </div>
<% else %>
  <div class="space-y-6">
    <% %w[active disabled archived].each do |status| %>
      <% scenarios = scenario_groups.fetch(status, []) %>
      <% next if scenarios.empty? %>

      <section aria-labelledby="forecast-scenarios-<%= status %>-heading" class="space-y-3">
        <h2 id="forecast-scenarios-<%= status %>-heading"
            class="text-secondary text-xs font-medium uppercase tracking-wide">
          <%= t("forecasts.scenarios.groups.#{status}", count: scenarios.size) %>
        </h2>
        <div class="space-y-3">
          <% scenarios.each do |scenario| %>
            <%= render "forecast/scenarios/scenario_row", scenario: scenario %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
<% end %>
