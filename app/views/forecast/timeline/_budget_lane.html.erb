<%# locals: (model:) %>
<%#
  Budget lane: monthly category projections. One disclosure per month (native
  <details>, keyboard-operable) listing each category projection's budgeted vs
  projected vs available, with the row's source (budget_inheritance /
  forecast_event / recurring / pending / forecast_effect). The category
  projections are eager-loaded per month so this lane issues no per-month query.
%>
<article class="rounded-xl border border-primary bg-container p-4 sm:p-5 space-y-4"
         aria-labelledby="timeline-budget-lane-heading"
         data-testid="timeline-budget-lane">
  <div class="space-y-1">
    <h4 id="timeline-budget-lane-heading" class="text-primary text-sm font-medium">
      <%= t("forecasts.timeline.budget_lane.heading") %>
    </h4>
    <p class="text-secondary text-xs"><%= t("forecasts.timeline.budget_lane.subtitle") %></p>
  </div>

  <% months_with_budget = model.all_monthly_entries.select { |month| model.budget_rows_for(month).any? } %>
  <% if months_with_budget.any? %>
    <div class="space-y-2">
      <% months_with_budget.each do |month| %>
        <% rows = model.budget_rows_for(month) %>
        <details class="rounded-lg border border-primary">
          <summary class="flex cursor-pointer items-center justify-between gap-3 px-3 py-2">
            <span class="text-primary text-sm font-medium"><%= l(month.period_start_on, format: :month_year) %></span>
            <span class="flex items-center gap-2">
              <span class="text-secondary text-xs"><%= t("forecasts.timeline.budget_lane.row_count", count: rows.size) %></span>
              <%= icon "chevron-down", size: "sm" %>
            </span>
          </summary>
          <div class="border-t border-primary overflow-x-auto">
            <table class="w-full text-sm">
              <caption class="sr-only"><%= t("forecasts.timeline.budget_lane.caption", month: l(month.period_start_on, format: :month_year)) %></caption>
              <thead>
                <tr class="border-b border-primary text-secondary text-left">
                  <th scope="col" class="px-3 py-2 font-medium"><%= t("forecasts.timeline.budget_lane.category") %></th>
                  <th scope="col" class="px-3 py-2 font-medium"><%= t("forecasts.timeline.budget_lane.source") %></th>
                  <th scope="col" class="px-3 py-2 font-medium text-right"><%= t("forecasts.timeline.budget_lane.budgeted") %></th>
                  <th scope="col" class="px-3 py-2 font-medium text-right"><%= t("forecasts.timeline.budget_lane.projected") %></th>
                  <th scope="col" class="px-3 py-2 font-medium text-right"><%= t("forecasts.timeline.budget_lane.available") %></th>
                </tr>
              </thead>
              <tbody class="text-primary">
                <% rows.each do |row| %>
                  <tr class="border-b border-primary last:border-0">
                    <th scope="row" class="px-3 py-2 font-medium text-left"><%= row.label %></th>
                    <td class="px-3 py-2">
                      <%= render DS::Pill.new(
                        label: t("forecasts.timeline.sources.#{row.source}", default: row.source.to_s.humanize),
                        tone: :gray,
                        style: :soft,
                        size: :sm
                      ) %>
                    </td>
                    <td class="px-3 py-2 text-right tabular-nums"><%= format_money(row.budgeted) %></td>
                    <td class="px-3 py-2 text-right tabular-nums"><%= format_money(row.projected) %></td>
                    <td class="px-3 py-2 text-right tabular-nums"><%= format_money(row.available) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </details>
      <% end %>
    </div>
  <% else %>
    <p class="text-secondary text-sm" data-testid="timeline-budget-empty"><%= t("forecasts.timeline.budget_lane.empty") %></p>
  <% end %>
</article>
