<%# locals: (model:, resolution:) %>
<%#
  Cash lane: the resolution-aware lane. The daily pane lists the 0-90 daily cash
  balances; the monthly pane lists the 4-36 monthly cash flow. The Stimulus
  controller toggles which pane is visible. A sparkline (the shared
  time-series-chart) summarizes the cash runway when there are enough points.
  Each row exposes a source-contribution drilldown read from persisted JSON.
%>
<article class="rounded-xl border border-primary bg-container p-4 sm:p-5 space-y-4"
         aria-labelledby="timeline-cash-lane-heading"
         data-testid="timeline-cash-lane">
  <div class="space-y-1">
    <h4 id="timeline-cash-lane-heading" class="text-primary text-sm font-medium">
      <%= t("forecasts.timeline.cash_lane.heading") %>
    </h4>
    <p class="text-secondary text-xs"><%= t("forecasts.timeline.cash_lane.subtitle") %></p>
  </div>

  <% cash_series = model.cash_series %>
  <% if cash_series&.any? %>
    <div id="timelineCashSparkline"
         class="w-full min-h-40 privacy-sensitive"
         data-controller="time-series-chart"
         data-time-series-chart-data-value="<%= cash_series.to_json %>"></div>
  <% end %>

  <%# Daily pane (0-90). Hidden when the monthly resolution is active. %>
  <div data-forecast-timeline-target="pane"
       data-resolution="daily"
       class="<%= "hidden" unless resolution == "daily" %>"
       data-testid="timeline-cash-daily">
    <% daily_entries = model.daily_entries %>
    <% if daily_entries.any? %>
      <div class="space-y-2">
        <% daily_entries.each_slice(7).with_index do |entries, week_index| %>
          <%
            first_entry = entries.first
            last_entry = entries.last
            minimum_runway_days = entries.filter_map(&:cash_runway_days).min
          %>
          <details class="rounded-lg border border-primary" <%= "open" if week_index.zero? %> data-testid="timeline-cash-week">
            <summary class="flex cursor-pointer flex-col gap-2 px-3 py-2 sm:flex-row sm:items-center sm:justify-between">
              <span class="text-primary text-sm font-medium">
                <%= l(first_entry.date, format: :long) %> - <%= l(last_entry.date, format: :long) %>
              </span>
              <span class="flex flex-wrap items-center gap-x-3 gap-y-1 text-secondary text-xs">
                <span>
                  <%= t("forecasts.timeline.cash_lane.cash") %>
                  <span class="tabular-nums"><%= format_money(first_entry.cash_balance) %> -> <%= format_money(last_entry.cash_balance) %></span>
                </span>
                <span>
                  <%= t("forecasts.timeline.cash_lane.runway") %>
                  <span class="tabular-nums">
                    <%= minimum_runway_days.present? ? t("forecasts.timeline.cash_lane.runway_days", count: minimum_runway_days) : t("forecasts.timeline.cash_lane.runway_unknown") %>
                  </span>
                </span>
                <%= icon "chevron-down", size: "sm" %>
              </span>
            </summary>
            <div class="border-t border-primary overflow-x-auto">
              <table class="w-full text-sm">
                <caption class="sr-only"><%= t("forecasts.timeline.cash_lane.daily_caption") %></caption>
                <thead>
                  <tr class="border-b border-primary text-secondary text-left">
                    <th scope="col" class="px-3 py-2 font-medium"><%= t("forecasts.timeline.cash_lane.date") %></th>
                    <th scope="col" class="px-3 py-2 font-medium text-right"><%= t("forecasts.timeline.cash_lane.cash") %></th>
                    <th scope="col" class="px-3 py-2 font-medium text-right"><%= t("forecasts.timeline.cash_lane.runway") %></th>
                    <th scope="col" class="px-3 py-2 font-medium text-right"><%= t("forecasts.timeline.drilldown.column") %></th>
                  </tr>
                </thead>
                <tbody class="text-primary">
                  <% entries.each do |entry| %>
                    <tr class="border-b border-primary last:border-0 align-top">
                      <th scope="row" class="px-3 py-2 font-medium text-secondary text-left whitespace-nowrap"><%= l(entry.date, format: :long) %></th>
                      <td class="px-3 py-2 text-right tabular-nums"><%= format_money(entry.cash_balance) %></td>
                      <td class="px-3 py-2 text-right tabular-nums">
                        <%= entry.cash_runway_days.present? ? t("forecasts.timeline.cash_lane.runway_days", count: entry.cash_runway_days) : t("forecasts.timeline.cash_lane.runway_unknown") %>
                      </td>
                      <td class="px-3 py-2 text-right">
                        <%= render "forecast/timeline/drilldown",
                              model: model,
                              source_breakdown: entry.source_breakdown,
                              period_label: l(entry.date, format: :long) %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </details>
        <% end %>
      </div>
    <% else %>
      <p class="text-secondary text-sm"><%= t("forecasts.timeline.cash_lane.daily_empty") %></p>
    <% end %>
  </div>

  <%# Monthly pane (4-36). Hidden when the daily resolution is active. %>
  <div data-forecast-timeline-target="pane"
       data-resolution="monthly"
       class="<%= "hidden" unless resolution == "monthly" %>"
       data-testid="timeline-cash-monthly">
    <% if model.monthly_entries.any? %>
      <div class="overflow-x-auto rounded-lg border border-primary">
        <table class="w-full text-sm">
          <caption class="sr-only"><%= t("forecasts.timeline.cash_lane.monthly_caption") %></caption>
          <thead>
            <tr class="border-b border-primary text-secondary text-left">
              <th scope="col" class="px-3 py-2 font-medium"><%= t("forecasts.timeline.cash_lane.month") %></th>
              <th scope="col" class="px-3 py-2 font-medium text-right"><%= t("forecasts.timeline.cash_lane.net_cash_flow") %></th>
              <th scope="col" class="px-3 py-2 font-medium text-right"><%= t("forecasts.timeline.cash_lane.cash") %></th>
              <th scope="col" class="px-3 py-2 font-medium text-right"><%= t("forecasts.timeline.drilldown.column") %></th>
            </tr>
          </thead>
          <tbody class="text-primary">
            <% model.monthly_entries.each do |entry| %>
              <tr class="border-b border-primary last:border-0 align-top">
                <th scope="row" class="px-3 py-2 font-medium text-secondary text-left whitespace-nowrap"><%= l(entry.period_start_on, format: :month_year) %></th>
                <td class="px-3 py-2 text-right tabular-nums"><%= format_money(entry.net_cash_flow) %></td>
                <td class="px-3 py-2 text-right tabular-nums"><%= format_money(entry.cash_balance) %></td>
                <td class="px-3 py-2 text-right">
                  <%= render "forecast/timeline/drilldown",
                        model: model,
                        source_breakdown: entry.source_breakdown,
                        period_label: l(entry.period_start_on, format: :month_year) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-secondary text-sm"><%= t("forecasts.timeline.cash_lane.monthly_empty") %></p>
    <% end %>
  </div>
</article>
