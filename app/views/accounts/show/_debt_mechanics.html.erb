<%# locals: (account:) %>

<% if account.debt_mechanics_supported? %>
  <% profile = account.debt_profile %>
  <% terms = Debt::AccountTerms.new(account).resolve %>

  <div class="mt-4 space-y-3">
    <div class="flex items-center justify-between gap-3">
      <h3 class="text-sm font-medium text-primary"><%= t("debt_profiles.overview.title") %></h3>
      <% unless account.loan? %>
        <%= render DS::Link.new(
          text: profile.present? ? t("debt_profiles.overview.edit") : t("debt_profiles.overview.configure"),
          variant: "ghost",
          icon: "settings",
          href: edit_account_debt_profile_path(account),
          frame: :modal
        ) %>
      <% end %>
    </div>

    <div class="grid grid-cols-2 gap-2 lg:grid-cols-4">
      <%= summary_card title: t("debt_profiles.overview.status") do %>
        <%= profile&.status&.titleize || t("debt_profiles.overview.not_configured") %>
      <% end %>

      <%= summary_card title: t("debt_profiles.overview.interest_rate") do %>
        <% if terms.annual_rate.present? %>
          <%= number_to_percentage(terms.annual_rate, precision: 3) %>
        <% else %>
          <%= t("debt_profiles.overview.unknown") %>
        <% end %>
      <% end %>

      <%= summary_card title: t("debt_profiles.overview.minimum_payment") do %>
        <% if terms.monthly_payment.present? %>
          <%= format_money Money.new(terms.monthly_payment, account.currency) %>
        <% else %>
          <%= t("debt_profiles.overview.unknown") %>
        <% end %>
      <% end %>

      <%= summary_card title: t("debt_profiles.overview.next_due") do %>
        <% if profile&.next_due_on.present? %>
          <%= l(profile.next_due_on, format: :long) %>
        <% else %>
          <%= t("debt_profiles.overview.not_scheduled") %>
        <% end %>
      <% end %>
    </div>

    <% if profile.present? %>
      <div class="grid grid-cols-2 gap-2 text-sm text-secondary">
        <div class="rounded-lg border border-primary p-3">
          <span class="block text-primary"><%= t("debt_profiles.overview.interest") %></span>
          <%= profile.auto_accrual_enabled? ? t("debt_profiles.overview.on") : t("debt_profiles.overview.off") %>
        </div>

        <div class="rounded-lg border border-primary p-3">
          <span class="block text-primary"><%= t("debt_profiles.overview.payment_allocation") %></span>
          <%= profile.auto_payment_allocation_enabled? ? t("debt_profiles.overview.on") : t("debt_profiles.overview.off") %>
        </div>
      </div>

      <% if account.student_loan? && profile.federal_student_loan.enabled? %>
        <% federal = profile.federal_student_loan %>
        <% repayment_scenarios = Debt::FederalStudentLoan::RepaymentPlan::Comparison.new(profile).call %>

        <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3">
          <%= summary_card title: t("debt_profiles.overview.principal_balance") do %>
            <%= format_money Money.new(federal.principal_balance, account.currency) %>
          <% end %>

          <%= summary_card title: t("debt_profiles.overview.accrued_interest") do %>
            <%= format_money Money.new(federal.accrued_interest_balance, account.currency) %>
          <% end %>

          <%= summary_card title: t("debt_profiles.overview.school_status") do %>
            <%= t("debt_profiles.edit.#{federal.school_status}") %>
          <% end %>
        </div>

        <% if repayment_scenarios.any? %>
          <div class="mt-3 rounded-lg border border-primary p-3">
            <p class="mb-2 text-sm font-medium text-primary"><%= t("debt_profiles.overview.repayment_scenarios") %></p>
            <div class="divide-y divide-primary">
              <% repayment_scenarios.each do |scenario| %>
                <div class="grid grid-cols-3 gap-2 py-2 text-sm">
                  <span class="text-primary"><%= scenario.plan_name %></span>
                  <span class="text-secondary">
                    <% if scenario.available? %>
                      <%= format_money Money.new(scenario.first_payment_amount, account.currency) %>
                    <% else %>
                      <%= t("debt_profiles.overview.unavailable") %>
                    <% end %>
                  </span>
                  <span class="text-secondary">
                    <% if scenario.available? %>
                      <%= t("debt_profiles.overview.month_count", count: scenario.month_count) %>
                    <% else %>
                      <%= scenario.warnings.first %>
                    <% end %>
                  </span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
