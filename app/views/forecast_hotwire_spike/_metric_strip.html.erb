<%# locals: (plan:, index:) — JS rewrites these spans on scrub; server replaces the
    whole strip on save. Both write to the same metric targets. %>
<% p = plan.period(index) %>
<div id="forecast-spike-metrics" class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2">
  <% ForecastSpike::Plan::METRIC_LABELS.each do |key, label| %>
    <div class="bg-container border border-primary rounded-lg p-2">
      <div class="text-secondary text-xs"><%= label %></div>
      <div class="text-primary font-medium tabular-nums text-sm"
           data-forecast-spike-target="metric" data-metric-key="<%= key %>">
        <%= key == :runway_days ? "#{p[:metrics][key]} d" : number_to_currency(p[:metrics][key], precision: 0) %>
      </div>
    </div>
  <% end %>
</div>
