<%# THROWAWAY Hotwire viability spike. See ForecastHotwireSpikeController. %>
<div class="p-4 max-w-[1100px] mx-auto"
     data-controller="forecast-spike"
     data-forecast-spike-selected-index-value="<%= @selected_index %>"
     data-forecast-spike-currency-value="<%= @currency_code %>">

  <%= render "chart_data", plan: @plan %>

  <%# header %>
  <div class="flex items-start justify-between gap-3 mb-4">
    <div>
      <h1 class="text-primary text-xl font-medium">Forecast — Hotwire spike</h1>
      <p class="text-secondary text-sm">Seeded from your connected accounts. Local scrub + scoped Turbo Stream save, no Inertia/Vite.</p>
    </div>
    <%= render "freshness", state: "fresh" %>
  </div>

  <%# HUD — judge against the spec's budgets %>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-4">
    <div class="bg-container border border-primary rounded-lg p-2">
      <div class="text-secondary text-xs">Scrub latency</div>
      <div class="text-primary font-mono text-sm"><span data-forecast-spike-target="scrubLatency">—</span> ms</div>
    </div>
    <div class="bg-container border border-primary rounded-lg p-2">
      <div class="text-secondary text-xs">Network during scrub</div>
      <div class="text-primary font-mono text-sm"><span data-forecast-spike-target="scrubNetwork">0</span> req</div>
    </div>
    <div class="bg-container border border-primary rounded-lg p-2">
      <div class="text-secondary text-xs">Last save round-trip</div>
      <div class="text-primary font-mono text-sm"><span data-forecast-spike-target="saveLatency">—</span> ms</div>
    </div>
    <div class="bg-container border border-primary rounded-lg p-2">
      <div class="text-secondary text-xs">Full page renders</div>
      <div class="text-primary font-mono text-sm"><span data-forecast-spike-target="loadCount">1</span></div>
    </div>
  </div>

  <%# chart %>
  <div class="bg-container border border-primary rounded-xl p-4 mb-4">
    <div class="flex items-center justify-between mb-2">
      <div class="text-secondary text-sm">
        Net worth · selected
        <span class="text-primary font-medium" data-forecast-spike-target="selectedLabel">—</span>
      </div>
      <div class="text-secondary text-xs">Drag across the chart · ← → to step</div>
    </div>
    <div data-forecast-spike-target="chart" tabindex="0"
         class="w-full h-[280px] text-blue-500 outline-none focus:ring-2 focus:ring-blue-500 rounded-lg"></div>
  </div>

  <%# metric strip (partial owns #forecast-spike-metrics) %>
  <div class="mb-4">
    <%= render "metric_strip", plan: @plan, index: @selected_index, symbol: @currency_symbol %>
  </div>

  <%# lower: explanation + assumptions %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <div class="bg-container border border-primary rounded-xl p-4">
      <h2 class="text-primary font-medium mb-3">Why this period</h2>
      <%= render "explanation", plan: @plan, index: @selected_index, symbol: @currency_symbol %>
    </div>

    <div class="bg-container border border-primary rounded-xl p-4">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-primary font-medium">Assumptions</h2>
        <%= button_to "Reset", forecast_hotwire_spike_reset_path,
              class: "text-secondary text-xs underline" %>
      </div>

      <%# provenance: real starting balances from connected accounts %>
      <% o = @plan.opening_summary %>
      <div class="border border-primary rounded-lg p-3 mb-2">
        <div class="text-secondary text-xs uppercase tracking-wide mb-2">Starting balances · from your connected accounts</div>
        <div class="grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
          <% { "Cash" => :cash, "Portfolio" => :portfolio, "Other assets" => :other_assets, "Debt" => :debt, "Net worth" => :net_worth }.each do |label, key| %>
            <div class="flex justify-between">
              <span class="text-secondary"><%= label %></span>
              <span class="tabular-nums text-primary"><%= number_to_currency(o[key], unit: @currency_symbol, precision: 0) %></span>
            </div>
          <% end %>
        </div>
      </div>

      <div class="space-y-2">
        <% @plan.assumption_cards.each do |card| %>
          <%= render "assumption_card", card: card, index: @selected_index, symbol: @currency_symbol %>
        <% end %>
      </div>
    </div>
  </div>
</div>
