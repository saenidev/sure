<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title", account: @account.name)) %>

  <% dialog.with_body do %>
    <% if @error_message.present? %>
      <%= render DS::Alert.new(message: @error_message, variant: :error) %>
    <% end %>

    <%= styled_form_with model: @debt_profile, url: account_debt_profile_path(@account), scope: :debt_profile, method: :patch, data: { turbo: false }, class: "flex flex-col gap-4 text-primary" do |form| %>
      <div class="grid grid-cols-1 gap-3">
        <%= form.select :status,
              DebtProfile::STATUSES.map { |status| [t("debt_profiles.statuses.#{status}"), status] },
              { label: t(".status") } %>

        <div class="flex items-center justify-between gap-3 rounded-lg border border-primary p-3">
          <div>
            <p class="text-sm font-medium text-primary"><%= t(".auto_accrual_enabled") %></p>
          </div>
          <%= form.toggle :auto_accrual_enabled %>
        </div>

        <div class="flex items-center justify-between gap-3 rounded-lg border border-primary p-3">
          <div>
            <p class="text-sm font-medium text-primary"><%= t(".auto_payment_allocation_enabled") %></p>
          </div>
          <%= form.toggle :auto_payment_allocation_enabled %>
        </div>

        <div class="rounded-lg border border-primary p-3">
          <%= form.fields_for :federal_student_loan, @debt_profile.federal_student_loan do |federal_form| %>
            <div class="mb-3 flex items-center justify-between gap-3">
              <p class="text-sm font-medium text-primary"><%= t(".federal_student_loan") %></p>
              <%= federal_form.toggle :enabled %>
            </div>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <%= federal_form.select :subsidy_type,
                    Debt::FederalStudentLoan::Profile::SUBSIDY_TYPES.map { |value| [t(".#{value}"), value] },
                    { label: t(".subsidy_type"), include_blank: t(".blank") } %>

              <%= federal_form.select :school_status,
                    Debt::FederalStudentLoan::Profile::SCHOOL_STATUSES.map { |value| [t(".#{value}"), value] },
                    { label: t(".school_status"), include_blank: t(".blank") } %>

              <%= federal_form.number_field :principal_balance, label: t(".principal_balance"), step: 0.01, min: 0 %>
              <%= federal_form.number_field :accrued_interest_balance, label: t(".accrued_interest_balance"), step: 0.01, min: 0 %>
              <%= federal_form.number_field :interest_bearing_principal_balance, label: t(".interest_bearing_principal_balance"), step: 0.01, min: 0 %>
              <%= federal_form.number_field :weighted_average_rate, label: t(".weighted_average_rate"), step: 0.001, min: 0 %>
              <%= federal_form.date_field :servicer_balance_as_of, label: t(".servicer_balance_as_of") %>
            </div>
          <% end %>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <%= form.select :rate_type,
                DebtProfile::RATE_TYPES.map { |rate_type| [t("debt_profiles.rate_types.#{rate_type}"), rate_type] },
                { label: t(".rate_type"), include_blank: t(".blank") } %>

          <%= form.number_field :annual_rate,
                label: t(".annual_rate"),
                min: 0,
                step: 0.001 %>

          <div class="flex flex-col gap-1">
            <%= form.select :accrual_cadence,
                  DebtProfile::CADENCES.map { |cadence| [t("debt_profiles.cadences.#{cadence}"), cadence] },
                  { label: t(".accrual_cadence"), include_blank: t(".blank") } %>
            <p class="text-xs text-secondary"><%= t(".accrual_cadence_description") %></p>
          </div>

          <%= form.number_field :minimum_payment_percent,
                label: t(".minimum_payment_percent"),
                min: 0,
                step: 0.01 %>
        </div>

        <%= form.money_field :minimum_payment_amount,
              label: t(".minimum_payment_amount"),
              hide_currency: true,
              min: 0 %>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          <%= form.number_field :payment_due_day,
                label: t(".payment_due_day"),
                min: 1,
                max: 31 %>

          <%= form.number_field :statement_closing_day,
                label: t(".statement_closing_day"),
                min: 1,
                max: 31 %>

          <%= form.number_field :grace_period_days,
                label: t(".grace_period_days"),
                min: 0 %>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <%= form.date_field :effective_start_on, label: t(".effective_start_on") %>
          <%= form.date_field :effective_end_on, label: t(".effective_end_on") %>
        </div>
      </div>

      <%= form.submit t(".submit") %>
    <% end %>
  <% end %>
<% end %>
