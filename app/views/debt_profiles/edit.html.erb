<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title", account: @account.name)) %>

  <% dialog.with_body do %>
    <% if @error_message.present? %>
      <%= render DS::Alert.new(message: @error_message, variant: :error) %>
    <% end %>

    <%= render "debt_profiles/form",
          account: @account,
          debt_profile: @debt_profile,
          url: account_debt_profile_path(@account),
          show_federal_student_loan: @account.student_loan?,
          submit_text: t(".submit") %>
  <% end %>
<% end %>
